@inproceedings{xuPuffpuffPalsGamified2026,
  title = {Puffpuff {{Pals}}: {{A Gamified System}} for {{Pulmonary Rehabilitation}}},
  shorttitle = {Puffpuff {{Pals}}},
  booktitle = {Proceedings of the 2025 {{International Conference}} on {{Human-Engaged Computing}}},
  author = {Xu, Heyi and Yalkun, Rana and Liu, Junyue and Liu, Zhao and Zhao, Ningning and Li, Jing and Qiu, Shi},
  year = 2026,
  month = may,
  series = {{{ICHEC}} '25},
  pages = {1--7},
  publisher = {Association for Computing Machinery},
  address = {New York, NY, USA},
  doi = {10.1145/3786995.3787040},
  urldate = {2026-09-17},
  abstract = {Individuals prone to respiratory diseases such as asthma, chronic cough, and pneumonia often encounter considerable challenges in adhering to home-based pulmonary rehabilitation programs, largely due to limited engagement, low motivation, and the absence of interactive feedback. To address these barriers, we present Puffpuff Pals, an interdisciplinary self-assessment and rehabilitation tool designed for home use. The system integrates gamified training experiences with real-time respiratory monitoring to deliver biofeedback, featuring both a parkour mode and a boss battle mode to enhance user engagement. The ergonomically rounded design of the breathing trainer improves grip comfort, thereby increasing safety and usability. A pilot study with six participants was conducted, employing HRV-derived RMSSD as a key indicator of physiological response in conjunction with subjective evaluations of user experience. Preliminary findings indicate that Puffpuff Pals may facilitate more effective breathing training and show potential to improve adherence in home-based rehabilitation.},
  isbn = {979-8-4007-2234-9},
  file = {C:\Users\riley\Zotero\storage\RIXD99RD\Xu et al. - 2026 - Puffpuff Pals A Gamified System for Pulmonary Rehabilitation.pdf}
}

@article{yamamotoIntegrationPatientreportedOutcomes2026,
  title = {Integration of Patient-Reported Outcomes and Myokine Profiling for the Detection of Physical Inactivity in {{COPD}}: An Exploratory Multicentre Study},
  shorttitle = {Integration of Patient-Reported Outcomes and Myokine Profiling for the Detection of Physical Inactivity in {{COPD}}},
  author = {Yamamoto, Tasuku and Hirano, Tsunahiko and Doi, Keiko and {Fukatsu-Chikumoto}, Ayumi and Oishi, Keiji and Takahashi, Koichiro and Asai, Kazuhisa and Sasaki, Seigo and Nakanishi, Masanori and Minakata, Yoshiaki and Matsunaga, Kazuto},
  year = 2026,
  month = jan,
  journal = {Scientific Reports},
  volume = {16},
  number = {1},
  pages = {4403},
  publisher = {Nature Publishing Group},
  issn = {2045-2322},
  doi = {10.1038/s41598-025-34436-y},
  urldate = {2026-09-17},
  abstract = {Physical inactivity strongly predicts poor prognosis in chronic obstructive pulmonary disease (COPD) but is often underrecognized. We investigated whether combining patient-reported outcomes (PROs) with myokine profiling enhances detection of inactivity in COPD. In this multicentre cross-sectional study, 73 patients with stable COPD underwent PRO assessment (modified Medical Research Council dyspnea scale (mMRC), dyspnea-specific PROs (PROMs-D), COPD Assessment Test (CAT), Shortness of Breath Daily Activities Questionnaire (SOBDA-Q), and Kihon Checklist (KCL)), serum myokine measurement, and accelerometer-based physical activity evaluation, stratified into 1.0--1.5 METs (low-intensity/sedentary), {$\geq$}\,3.0 METs (moderate), total activity (METs{$\cdot$}h), and step count. Correlation and logistic regression analyses were performed. mMRC and PROMs-D correlated negatively with moderate activity and step count. Among myokines, growth differentiation factor-15 (GDF-15), fatty acid binding protein 3 (FABP3), and brain-derived neurotrophic factor (BDNF) showed moderate associations with physical activity: GDF-15 and BDNF with low-intensity, GDF-15 with moderate, and FABP3 and BDNF with step count. Combined PRO--myokine models outperformed single markers, with areas under the curve of 0.77 for low-intensity activity, 0.82 for moderate activity, and 0.86 for step count. In conclusion, integrating PROs and myokines improves the specificity and accuracy of inactivity detection in COPD. This multidimensional strategy may facilitate early, personalized interventions.},
  copyright = {2026 The Author(s)},
  langid = {english},
  keywords = {Biomarkers,Diseases,Health care,Medical research},
  file = {C:\Users\riley\Zotero\storage\IF69UCGJ\Yamamoto et al. - 2026 - Integration of patient-reported outcomes and myokine profiling for the detection of physical inactiv.pdf}
}

