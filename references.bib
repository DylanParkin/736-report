@article{kokInterpretableMachineLearning2025,
  title = {Interpretable Machine Learning Models for {{COPD}} Ease of Breathing Estimation},
  author = {Kok, Thomas T. and Morales, John and Deschrijver, Dirk and {Blanco-Almaz{\'a}n}, Dolores and Groenendaal, Willemijn and Ruttens, David and Smeets, Christophe and Mihajlovi{\'c}, Vojkan and Ongenae, Femke and Van Hoecke, Sofie},
  year = 2025,
