@article{mahlerMechanismsMeasurementDyspnea2006,
  title = {Mechanisms and {{Measurement}} of {{Dyspnea}} in {{Chronic Obstructive Pulmonary Disease}}},
  author = {Mahler, Donald A.},
  year = 2006,
  month = may,
  journal = {Proceedings of the American Thoracic Society},
  volume = {3},
  number = {3},
  pages = {234--238},
  issn = {1546-3222},
  doi = {10.1513/pats.200509-103SF},
  urldate = {2026-09-17},
  abstract = {Patients with chronic obstructive pulmonary disease (COPD) describe their breathlessness as related to the work and effort associated with breathing. Current evidence suggests that the perception of dyspnea is due to a ``mismatch'' between the outgoing motor command from the central nervous system and the corresponding afferent information from chemoreceptors and/or mechanoreceptors. To measure the severity of dyspnea the principles of psychophysics (stimulus {$\rightarrow$} response relationship) can be applied. One approach is to consider activities of daily living as a putative stimulus. Although this method relies on patient recall and description of daily tasks, ability to function, as well as time and effort to complete an activity, select clinical instruments have demonstrated appropriate measurement criteria in randomized clinical trials involving patients with COPD. Another approach is for a patient to report the intensity of dyspnea during exercise, and current practice is to provide ratings each minute ``on cue'' during the exercise test. A computerized system has been developed whereby the person can report ratings spontaneously and continuously by moving a computer mouse that adjusts a vertical bar adjacent to 0--10 category-ratio scale positioned on a monitor. With this continuous method the patient reports twice the number of dyspnea ratings during exercise compared with discrete ratings each minute. Patient-reported dyspnea based on activities of daily living and exercise testing provides distinct but complimentary information.},
  file = {C\:\\Users\\riley\\Zotero\\storage\\6XY96EVN\\Mahler - 2006 - Mechanisms and Measurement of Dyspnea in Chronic Obstructive Pulmonary Disease.pdf;C\:\\Users\\riley\\Zotero\\storage\\FES65RDV\\pats.html}
}

@inproceedings{matouqGamifiedRealTimeBiofeedback2026,
  title = {Gamified {{Real-Time Biofeedback}} for {{Pulmonary Rehabilitation}}},
  booktitle = {2026 1st {{International Conference}} on {{Emerging Technologies}} and {{Engineering Systems}} ({{ICETES}})},
  author = {Matouq, Jumana and Joudeh, Yara and Hamzeh, Zaina and Hamdona, Raneem and {AL-bawaneh}, Sadeen and Jbarah, Mira},
  year = 2026,
  month = apr,
  pages = {272--275},
  doi = {10.1109/ICETES68504.2026.11518716},
  urldate = {2026-09-18},
  abstract = {Respiratory rehabilitation of children demands high motivation from patients to maintain breathing exercises in a steady manner and to avoid low adherence. The current study aims at developing an interactive Flappy Bird game for pulmonary rehabilitation based on a virtual environment. The proposed gaming system is expected to motivate a steady engagement of children with chronic respiratory conditions at a low cost and with real-time biofeedback. The developed system consists of a flow sensor, a microcontroller, and a Python physics engine that translate the user's inhalations into a vertical movement of a digital avatar bird. The flow sensor was calibrated using a custom calibration factor to ensure it accurately detects air movements. Digital smoothing techniques were used to make the game movement feel natural and stable. The system was tested initially on five healthy subjects, where the subjects' inhalations were converted into calibrated airflow data. This data is related to breathing intensity and controls the vertical movement of a bird avatar, which requires the user to maintain a specific therapeutic range. The results showed that the closed-loop system allowed the user to adjust their breathing patterns using the real-time visual feedback, including the therapeutic target zone. These results effectively validate the responsive functionality of the sensor to software pipeline and its efficiency for respiratory biofeedback. Furthermore, the integration of the affordable flow sensor with a smart software shows that such a system provides an accessible and motivating biofeedback environment for pulmonary rehabilitation.},
  keywords = {Biological control systems,Birds,Calibration,Distance measurement,Fluid flow,game rehabilitation,Games,Image sensors,incentive spirometry,Measurement,pulmonary health,Real-time systems,Respiratory rehabilitation,SDG 3,Timing},
  file = {C:\Users\riley\Zotero\storage\879TI83F\Matouq et al. - 2026 - Gamified Real-Time Biofeedback for Pulmonary Rehabilitation.pdf}
}

