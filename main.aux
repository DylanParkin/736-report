\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Participant S7, sitting: wrist PPG (top); heart rate from the chest ECG reference vs. the wrist-PPG pulse detector (middle); and respiration rate from the RespiBAN ensemble ground truth vs. the wrist-PPG-derived estimate, after per-participant DC baseline calibration (bottom). The PPG-derived respiration rate closely tracks the reference level and slow trend (MAE 1.8 breaths/min, RMSE 2.3 breaths/min).}}{7}{figure.4}\protected@file@percent }
\newlabel{fig:s7-rr}{{4}{7}{Participant S7, sitting: wrist PPG (top); heart rate from the chest ECG reference vs. the wrist-PPG pulse detector (middle); and respiration rate from the RespiBAN ensemble ground truth vs. the wrist-PPG-derived estimate, after per-participant DC baseline calibration (bottom). The PPG-derived respiration rate closely tracks the reference level and slow trend (MAE 1.8 breaths/min, RMSE 2.3 breaths/min)}{figure.4}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Participant S8, sitting: wrist PPG (top); heart rate from the chest ECG reference vs. the wrist-PPG pulse detector (middle); and respiration rate from the RespiBAN ensemble ground truth vs. the wrist-PPG-derived estimate, after per-participant DC baseline calibration (bottom). The PPG-derived respiration rate again tracks the reference level and slow trend reasonably closely (MAE 2.2 breaths/min, RMSE 2.8 breaths/min), though heart rate tracking is more affected by intermittent motion artefacts than for S7.}}{8}{figure.5}\protected@file@percent }
\newlabel{fig:s8-rr}{{5}{8}{Participant S8, sitting: wrist PPG (top); heart rate from the chest ECG reference vs. the wrist-PPG pulse detector (middle); and respiration rate from the RespiBAN ensemble ground truth vs. the wrist-PPG-derived estimate, after per-participant DC baseline calibration (bottom). The PPG-derived respiration rate again tracks the reference level and slow trend reasonably closely (MAE 2.2 breaths/min, RMSE 2.8 breaths/min), though heart rate tracking is more affected by intermittent motion artefacts than for S7}{figure.5}{}}
