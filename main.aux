\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Ground truth respiration rate estimation for the sitting sections of (a) S7 and (b) S8: raw chest RespiBAN respiration signal (top) and the resulting fused rate at each accepted window, with a smoothed trend (bottom). The high proportion of accepted windows (97\% S7, 89\% S8) and low estimate variance ($\pm 1.4$--$1.6$ breaths/min) support the use of this ensemble as ground truth for validating the wrist-PPG-derived estimate.}}{5}{figure.2}\protected@file@percent }
\newlabel{fig:gt-sitting}{{2}{5}{Ground truth respiration rate estimation for the sitting sections of (a) S7 and (b) S8: raw chest RespiBAN respiration signal (top) and the resulting fused rate at each accepted window, with a smoothed trend (bottom). The high proportion of accepted windows (97\% S7, 89\% S8) and low estimate variance ($\pm 1.4$--$1.6$ breaths/min) support the use of this ensemble as ground truth for validating the wrist-PPG-derived estimate}{figure.2}{}}
